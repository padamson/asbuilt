  asbuilt_rust.walk -[names]-> asbuilt_rust.source 'FileSource'
  asbuilt_site.app -[uses]-> asbuilt_site.components.dogfood_banner 'DogfoodBanner'
  asbuilt_site.app -[uses]-> asbuilt_site.components.example 'Example'
  asbuilt_site.app -[uses]-> asbuilt_site.components.features 'Features'
  asbuilt_site.app -[uses]-> asbuilt_site.components.footer 'Footer'
  asbuilt_site.app -[uses]-> asbuilt_site.components.hero 'Hero'
  asbuilt_site.app -[uses]-> asbuilt_site.components.how_it_works 'HowItWorks'
  asbuilt_site.app -[uses]-> asbuilt_site.components.install 'Install'
  asbuilt_site.app -[uses]-> asbuilt_site.components.roadmap 'Roadmap'
  asbuilt_site.app -[uses]-> asbuilt_site.components.version_switcher 'VersionSwitcher'
  asbuilt_site.components.example -[uses]-> asbuilt_site.components.code_block 'CodeBlock'
  asbuilt_site.components.example -[uses]-> asbuilt_site.snippets 'snippets'
  asbuilt_site.components.feature_card -[calls]-> asbuilt_site.version 'is_dev'
  asbuilt_site.components.features -[uses]-> asbuilt_site.components.code_block 'CodeBlock'
  asbuilt_site.components.features -[uses]-> asbuilt_site.components.feature_card 'FeatureCard'
  asbuilt_site.components.features -[uses]-> asbuilt_site.snippets 'snippets'
  asbuilt_site.components.footer -[calls]-> asbuilt_site.version 'is_dev'
  asbuilt_site.components.hero -[uses]-> asbuilt_site.components.icons_ 'Icon, icons'
  asbuilt_site.components.hero -[calls]-> asbuilt_site.version 'is_dev'
  asbuilt_site.components.how_it_works -[uses]-> asbuilt_site.components.code_tabs 'CodeTabs'
  asbuilt_site.components.how_it_works -[uses]-> asbuilt_site.snippets 'snippets'
  asbuilt_site.components.install -[uses]-> asbuilt_site.components.code_block 'CodeBlock'
  asbuilt_site.components.install -[uses]-> asbuilt_site.snippets 'snippets'
  asbuilt_site.components.install -[calls]-> asbuilt_site.version 'is_dev'
  asbuilt_site.components.roadmap -[calls]-> asbuilt_site.roadmap 'Horizon, ITEMS, Item, MILESTONE, NEXT_MILESTONE, Status, progress, roadmap'
  asbuilt_site.components.version_switcher -[calls]-> asbuilt_site.version 'SITE_VERSION, is_dev, manifest_url, snapshot_url'
  asbuilt_site_e2e.tests -[uses]-> chromium 'drives'
}

views {
  view index {
    title 'Overview'
    include asbuilt, asbuilt_core, asbuilt_rust, asbuilt_site, asbuilt_site_e2e, cargo, chromium, graphviz, likec4
    autoLayout LeftRight
  }

  view view_asbuilt of asbuilt {
    title 'asbuilt'
    include *
    autoLayout TopBottom
  }

  view view_asbuilt_core of asbuilt_core {
    title 'asbuilt_core'
    include *
    autoLayout TopBottom
  }

  view view_asbuilt_rust of asbuilt_rust {
    title 'asbuilt_rust'
    include *
    autoLayout TopBottom
  }

  view view_asbuilt_site of asbuilt_site {
    title 'asbuilt_site'
    include *
    autoLayout TopBottom
  }

  view view_asbuilt_site_components of asbuilt_site.components {
    title 'asbuilt_site.components'
    include *
    autoLayout TopBottom
  }

  view view_asbuilt_site_e2e of asbuilt_site_e2e {
    title 'asbuilt_site_e2e'
    include *
    autoLayout TopBottom
  }
}
