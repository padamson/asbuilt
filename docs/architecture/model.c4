// GENERATED by asbuilt. Do not edit; run asbuilt survey.

specification {
  color theme_bin #f0a884
  color theme_component #ffffff
  color theme_container #ce422b
  color theme_process #e9d4c8
  color theme_tests #d9d4cf
  element bin {
    style {
      color theme_bin
    }
  }
  element component {
    style {
      color theme_component
    }
  }
  element container {
    style {
      color theme_container
    }
  }
  element process {
    style {
      color theme_process
    }
  }
  element tests {
    style {
      color theme_tests
    }
  }
  tag bin
  tag external
  tag tests
  relationship implements
  relationship constructs
  relationship calls
  relationship names
  relationship uses
}

model {
  asbuilt = container 'asbuilt' {
    description 'The `asbuilt` CLI crate: `main.rs` parses arguments, and this
library runs the subcommands (`commands`) and every call to the
pinned LikeC4 (`likec4`).'
    technology 'library and binary crate'
    metadata {
      path 'crates/asbuilt'
    }
    link ../../crates/asbuilt
    asbuilt = bin 'asbuilt' {
      #bin
      description 'The `asbuilt` command line: `survey` writes the model, `check` fails
when the committed one is stale, `docs` writes the documentation
tree, and `validate`, `export json` and `render` hand the model to
the pinned LikeC4.'
      metadata {
        path 'crates/asbuilt/src/main.rs'
      }
      link ../../crates/asbuilt/src/main.rs
    }
    commands = component 'commands' {
      description 'The subcommands, as functions that return an exit code, so the binary
is a thin `main` and the tests can drive each path. `survey` and
`check` need no Node; `validate`, `export json` and `render` shell
out to the pinned LikeC4 (and `render` to Graphviz).'
      metadata {
        path 'crates/asbuilt/src/commands.rs'
      }
      link ../../crates/asbuilt/src/commands.rs
    }
    likec4 = component 'likec4' {
      description 'The pinned `npx likec4` calls, plus Graphviz for rendering. Everything
downstream of the model is LikeC4\'s; this module runs it and reports
what it said.'
      metadata {
        path 'crates/asbuilt/src/likec4.rs'
      }
      link ../../crates/asbuilt/src/likec4.rs
    }
    tests = tests 'tests' {
      #tests
      metadata {
        path 'crates/asbuilt/tests'
      }
      link ../../crates/asbuilt/tests
    }
  }
  asbuilt_core = container 'asbuilt-core' {
    description 'The language-agnostic core of asbuilt.'
    technology 'library crate'
    metadata {
      path 'crates/asbuilt-core'
    }
    link ../../crates/asbuilt-core
    check = component 'check' {
      description 'The drift check: the committed model against a fresh survey, as a
unified diff when they differ. Line endings are normalized first so
a consumer with `autocrlf` gets a clean check.'
      metadata {
        path 'crates/asbuilt-core/src/check.rs'
      }
      link ../../crates/asbuilt-core/src/check.rs
    }
    config = component 'config' {
      description '`asbuilt.toml`: the release it is written for, the output path, the
externals nothing static in the code can state, and every front-end\'s
own table kept raw for it to parse.'
      metadata {
        path 'crates/asbuilt-core/src/config.rs'
      }
      link ../../crates/asbuilt-core/src/config.rs
    }
    docs = component 'docs' {
      description 'The documentation generator: a [`Model`] and the SVGs `asbuilt render`
produced, to a static HTML tree that mounts anywhere. A view LikeC4
drew is inlined into its page ([`crate::svg`]) and colored by
`theme.css` ([`crate::theme`]) for the system\'s light or dark scheme or
a visitor\'s choice; `theme.js`, the tree\'s one script, carries that
choice and is left out when `scheme_toggle` is off.'
      metadata {
        path 'crates/asbuilt-core/src/docs.rs'
      }
      link ../../crates/asbuilt-core/src/docs.rs
    }
    emit = component 'emit' {
      description 'The LikeC4 emitter: a [`Model`] to the text of one `.c4` file.'
      metadata {
        path 'crates/asbuilt-core/src/emit.rs'
      }
      link ../../crates/asbuilt-core/src/emit.rs
    }
    error = component 'error' {
      description 'Errors that name the offending input, so a message reads without a
rerun.'
      metadata {
        path 'crates/asbuilt-core/src/error.rs'
      }
      link ../../crates/asbuilt-core/src/error.rs
    }
    externals = component 'externals' {
      description 'Externals from `asbuilt.toml`: elements outside the code (a spawned
process, a browser) and the edges from surveyed modules to them.
Nothing static in the code states these, so the config does, and a
`from` that names no element is an error rather than a missing edge.'
      metadata {
        path 'crates/asbuilt-core/src/externals.rs'
      }
      link ../../crates/asbuilt-core/src/externals.rs
    }
    frontend = component 'frontend' {
      description 'The front-end contract and the survey that runs every front-end
that recognizes a root, merges their models, and applies the config.'
      metadata {
        path 'crates/asbuilt-core/src/frontend.rs'
      }
      link ../../crates/asbuilt-core/src/frontend.rs
    }
    model = component 'model' {
      description 'The architecture model every front-end produces and the emitter
consumes.'
      metadata {
        path 'crates/asbuilt-core/src/model.rs'
      }
      link ../../crates/asbuilt-core/src/model.rs
    }
    svg = component 'svg' {
      description 'A rendered view inlined into a page, so the page\'s colors reach it.'
      metadata {
        path 'crates/asbuilt-core/src/svg.rs'
      }
      link ../../crates/asbuilt-core/src/svg.rs
    }
    tests = tests 'tests' {
      #tests
      metadata {
        path 'crates/asbuilt-core/tests'
      }
      link ../../crates/asbuilt-core/tests
    }
    theme = component 'theme' {
      description 'Diagram colors for the documentation pages. Per element kind, a light
and a dark fill come from `[theme]` (LikeC4\'s default blue for a kind
with none), and each fill\'s text, secondary text and outline are
derived from it. `theme.css` sets them as `--c4-<kind>-*` variables for
the system\'s light and dark schemes and for a visitor\'s explicit
choice (`data-theme` on the root), then applies them to the nodes of an
inlined view. Group boxes, edges and edge labels take their colors
from the page tokens (`--bg`, `--fg`, `--muted`), so a host stylesheet
that restates those restyles the diagrams with the page.'
      metadata {
        path 'crates/asbuilt-core/src/theme.rs'
      }
      link ../../crates/asbuilt-core/src/theme.rs
    }
  }
  asbuilt_rust = container 'asbuilt-rust' {
    description 'Rust front-end for asbuilt.'
    technology 'library crate'
    metadata {
      path 'crates/asbuilt-rust'
    }
    link ../../crates/asbuilt-rust
    aggregate = component 'aggregate' {
      description 'From resolved references to model relations: element ids per target
role, one relation per (source, target) pair with the strongest
kind and the sorted item names, and nothing between an element and
its own ancestors or descendants.'
      metadata {
        path 'crates/asbuilt-rust/src/aggregate.rs'
      }
      link ../../crates/asbuilt-rust/src/aggregate.rs
    }
    config = component 'config' {
      description 'The `[rust]` table of `asbuilt.toml`.'
      metadata {
        path 'crates/asbuilt-rust/src/config.rs'
      }
      link ../../crates/asbuilt-rust/src/config.rs
    }
    discover = component 'discover' {
      description 'Crates and their targets, from `cargo metadata --no-deps --offline`
on the root manifest and on each `[rust] extra_manifests` entry.
`--no-deps` reads manifests only: no resolution, no network, no
lockfile written.'
      metadata {
        path 'crates/asbuilt-rust/src/discover.rs'
      }
      link ../../crates/asbuilt-rust/src/discover.rs
    }
    error = component 'error' {
      description 'What the Rust front-end can get wrong, each naming the path or
module involved.'
      metadata {
        path 'crates/asbuilt-rust/src/error.rs'
      }
      link ../../crates/asbuilt-rust/src/error.rs
    }
    resolve = component 'resolve' {
      description 'Path resolution over an in-memory tree of targets and modules: which
module, and which item in it, a path written in some module refers
to. Pure functions; the tests build trees by hand. Re-exports are
followed by substitution to a fixed point, globs are consulted when
a direct lookup fails, and a path that stops at a segment that is
neither module nor re-export is attributed to the module reached
(the lenient stop), which is what keeps derive-generated names
resolvable.'
      metadata {
        path 'crates/asbuilt-rust/src/resolve.rs'
      }
      link ../../crates/asbuilt-rust/src/resolve.rs
    }
    source = component 'source' {
      description 'Where source text comes from. The walk reads through this trait so
its tests run over an in-memory map and never touch a disk.'
      metadata {
        path 'crates/asbuilt-rust/src/source.rs'
      }
      link ../../crates/asbuilt-rust/src/source.rs
    }
    tests = tests 'tests' {
      #tests
      metadata {
        path 'crates/asbuilt-rust/tests'
      }
      link ../../crates/asbuilt-rust/tests
    }
    visit = component 'visit' {
      description 'What one parsed file references, per module: every `use`, every
path in a type, expression or pattern, every `impl Trait for`, and
the names the module defines. Pure over a `syn::File`; the tests
parse strings. A macro invocation\'s body is parsed as Rust where it
is Rust (comma-separated expressions, statements, or items), so
`fuzz_target!`, `assert_eq!` and both forms of `vec!` yield their
references; a body in another syntax (Leptos `view!`, `macro_rules!`
arms) yields only the macro\'s own path. Method calls on values are
not paths and produce no reference.'
      metadata {
        path 'crates/asbuilt-rust/src/visit.rs'
      }
      link ../../crates/asbuilt-rust/src/visit.rs
    }
    walk = component 'walk' {
      description 'The module tree of one target, from its root file down every `mod`
declaration. Follows `mod x;` to `x.rs` or `x/mod.rs`, honors
`#[path]`, enters inline `mod x { }`, and skips anything under
`#[cfg(test)]`. Every file comes from a declaration, never from a
directory listing, so discovery order is out of the picture.'
      metadata {
        path 'crates/asbuilt-rust/src/walk.rs'
      }
      link ../../crates/asbuilt-rust/src/walk.rs
    }
  }
  asbuilt_site = container 'asbuilt-site' {
    technology 'binary crate'
    metadata {
      path 'crates/site'
    }
    link ../../crates/site
    app = component 'app' {
      metadata {
        path 'crates/site/src/app.rs'
      }
      link ../../crates/site/src/app.rs
    }
    components = component 'components' {
      metadata {
        path 'crates/site/src/components/mod.rs'
      }
      link ../../crates/site/src/components/mod.rs
      code_block = component 'code_block' {
        metadata {
          path 'crates/site/src/components/code_block.rs'
        }
        link ../../crates/site/src/components/code_block.rs
      }
      code_tabs = component 'code_tabs' {
        metadata {
          path 'crates/site/src/components/code_tabs.rs'
        }
        link ../../crates/site/src/components/code_tabs.rs
      }
      dogfood_banner = component 'dogfood_banner' {
        metadata {
          path 'crates/site/src/components/dogfood_banner.rs'
        }
        link ../../crates/site/src/components/dogfood_banner.rs
      }
      example = component 'example' {
        metadata {
          path 'crates/site/src/components/example.rs'
        }
        link ../../crates/site/src/components/example.rs
      }
      feature_card = component 'feature_card' {
        metadata {
          path 'crates/site/src/components/feature_card.rs'
        }
        link ../../crates/site/src/components/feature_card.rs
      }
      features = component 'features' {
        metadata {
          path 'crates/site/src/components/features.rs'
        }
        link ../../crates/site/src/components/features.rs
      }
      footer = component 'footer' {
        metadata {
          path 'crates/site/src/components/footer.rs'
        }
        link ../../crates/site/src/components/footer.rs
      }
      hero = component 'hero' {
        metadata {
          path 'crates/site/src/components/hero.rs'
        }
        link ../../crates/site/src/components/hero.rs
      }
      how_it_works = component 'how_it_works' {
        metadata {
          path 'crates/site/src/components/how_it_works.rs'
        }
        link ../../crates/site/src/components/how_it_works.rs
      }
      icons_ = component 'icons' {
        metadata {
          path 'crates/site/src/components/icons.rs'
        }
        link ../../crates/site/src/components/icons.rs
      }
      install = component 'install' {
        metadata {
          path 'crates/site/src/components/install.rs'
        }
        link ../../crates/site/src/components/install.rs
      }
      roadmap = component 'roadmap' {
        metadata {
          path 'crates/site/src/components/roadmap.rs'
        }
        link ../../crates/site/src/components/roadmap.rs
      }
      unreleased_badge = component 'unreleased_badge' {
        metadata {
          path 'crates/site/src/components/unreleased_badge.rs'
        }
        link ../../crates/site/src/components/unreleased_badge.rs
      }
      version_switcher = component 'version_switcher' {
        metadata {
          path 'crates/site/src/components/version_switcher.rs'
        }
        link ../../crates/site/src/components/version_switcher.rs
      }
    }
    roadmap = component 'roadmap' {
      description 'The roadmap as data: Now (the next release, with each item\'s status),
Next and Later. The section renders straight from `ITEMS`, so moving an
item is an edit here, made in the commit that does the work.'
      metadata {
        path 'crates/site/src/roadmap.rs'
      }
      link ../../crates/site/src/roadmap.rs
    }
    snippets = component 'snippets' {
      description 'Syntax-highlighted code snippets, generated at build time by `build.rs` from
the files in `snippets/`. Each constant holds highlighted inner HTML
(token spans with inline colors) rendered via `inner_html`.'
      metadata {
        path 'crates/site/src/snippets.rs'
      }
      link ../../crates/site/src/snippets.rs
    }
    version = component 'version' {
      description 'The build\'s version identity and the one place the site\'s path prefix
is spelled. `build.rs` injects `SITE_VERSION`; the deploy serves every
snapshot under `/asbuilt/<dev|vX.Y.Z>/` (project Pages), and only the
version switcher needs to know that: every other asset path is relative.'
      metadata {
        path 'crates/site/src/version.rs'
      }
      link ../../crates/site/src/version.rs
    }
  }
  asbuilt_site_e2e = container 'asbuilt-site-e2e' {
    technology 'test crate'
    metadata {
      path 'crates/site-e2e'
    }
    link ../../crates/site-e2e
    tests = tests 'tests' {
      #tests
      metadata {
        path 'crates/site-e2e/tests'
      }
      link ../../crates/site-e2e/tests
    }
  }
  cargo = process 'cargo metadata' {
    #external
    description 'Lists the workspace\'s packages and targets; `--no-deps --offline`, so no lockfile is touched.'
    technology 'cargo subprocess'
  }
  chromium = process 'Chromium' {
    #external
    description 'The browser the site\'s end-to-end tests drive against the built landing page.'
    technology 'Playwright driver, via playwright-rs'
  }
  graphviz = process 'Graphviz dot' {
    #external
    description 'Renders the Graphviz files LikeC4 generates to SVG.'
    technology 'dot subprocess'
  }
  likec4 = process 'LikeC4 CLI' {
    #external
    description 'Validates, exports and lays out the model. Only `validate`, `export json` and `render` reach it.'
    technology 'Node.js via npx, pinned version'
  }

  asbuilt.asbuilt -[constructs]-> asbuilt.commands 'DocsArgs, EXIT_ERROR, check, commands, docs, export_json, render, survey, validate'
  asbuilt.asbuilt -[names]-> asbuilt_core.config 'ColorScheme'
  asbuilt.commands -[calls]-> asbuilt.likec4 'LikeC4Error, export_json, likec4, render, validate'
  asbuilt.commands -[calls]-> asbuilt_core.check 'Outcome, compare'
  asbuilt.commands -[calls]-> asbuilt_core.config 'ColorScheme, Config'
  asbuilt.commands -[constructs]-> asbuilt_core.docs 'DocsOptions, GENERATOR_META, generate'
  asbuilt.commands -[calls]-> asbuilt_core.emit 'emit'
  asbuilt.commands -[names]-> asbuilt_core.error 'Error'
  asbuilt.commands -[calls]-> asbuilt_core.frontend 'Frontend, survey'
  asbuilt.commands -[names]-> asbuilt_core.model 'Model'
  asbuilt.commands -[constructs]-> asbuilt_core.svg 'ViewSource'
  asbuilt.commands -[names]-> asbuilt_rust 'RustFrontend'
  asbuilt.likec4 -[uses]-> graphviz 'renders with'
  asbuilt.likec4 -[uses]-> likec4 'runs'
  asbuilt.tests -[calls]-> asbuilt.likec4 'LikeC4Error, RENDER_SCRATCH, export_json, likec4, render, validate'
  asbuilt.tests -[calls]-> asbuilt_core.emit 'emit'
  asbuilt.tests -[constructs]-> asbuilt_core.model 'Element, ElementKind, Id, Model, Relation, RelationKind'
  asbuilt_core.config -[constructs]-> asbuilt_core.error 'Error, Result'
  asbuilt_core.docs -[names]-> asbuilt_core.config 'ColorScheme, ThemeColor'
  asbuilt_core.docs -[calls]-> asbuilt_core.emit 'children_of, link_encode, view_ids'
  asbuilt_core.docs -[calls]-> asbuilt_core.model 'Element, ElementKind, Id, Model, Relation, dotted, sanitize_id'
  asbuilt_core.docs -[constructs]-> asbuilt_core.svg 'Inlined, Node, ViewSource, inline, svg'
  asbuilt_core.docs -[calls]-> asbuilt_core.theme 'stylesheet, theme'
  asbuilt_core.emit -[calls]-> asbuilt_core.model 'Element, Id, Model, RelationKind, sanitize_id, sanitize_segment'
  asbuilt_core.externals -[names]-> asbuilt_core.config 'Config'
  asbuilt_core.externals -[constructs]-> asbuilt_core.error 'Error, Result'
  asbuilt_core.externals -[constructs]-> asbuilt_core.model 'Element, ElementKind, Id, Model, Relation, RelationKind, SURVEY_KINDS, dotted, sanitize_id, sanitize_segment'
  asbuilt_core.frontend -[names]-> asbuilt_core.config 'Config'
  asbuilt_core.frontend -[constructs]-> asbuilt_core.error 'Error, Result'
  asbuilt_core.frontend -[calls]-> asbuilt_core.externals 'apply, externals'
  asbuilt_core.frontend -[constructs]-> asbuilt_core.model 'Model'
  asbuilt_core.model -[constructs]-> asbuilt_core.error 'Error, Result'
  asbuilt_core.svg -[calls]-> asbuilt_core.docs 'escape'
  asbuilt_core.tests -[constructs]-> asbuilt_core.config 'Config'
  asbuilt_core.tests -[names]-> asbuilt_core.error 'Error'
  asbuilt_core.theme -[names]-> asbuilt_core.config 'ThemeColor'
  asbuilt_rust -[names]-> asbuilt_core.config 'Config'
  asbuilt_rust -[constructs]-> asbuilt_core.error 'Error, Result'
  asbuilt_rust -[implements]-> asbuilt_core.frontend 'Frontend'
  asbuilt_rust -[constructs]-> asbuilt_core.model 'Element, ElementKind, Id, Model'
  asbuilt_rust.aggregate -[constructs]-> asbuilt_core.model 'Id, Relation, RelationKind, is_lineal'
  asbuilt_rust.aggregate -[constructs]-> asbuilt_rust.resolve 'Location, ResolveTree, TargetKey, TargetRole, resolve'
  asbuilt_rust.aggregate -[names]-> asbuilt_rust.visit 'ModuleFacts'
  asbuilt_rust.aggregate -[names]-> asbuilt_rust.walk 'ModulePath'
  asbuilt_rust.config -[names]-> asbuilt_core.config 'Config'
  asbuilt_rust.config -[names]-> asbuilt_core.error 'Result'
  asbuilt_rust.discover -[names]-> asbuilt_rust.config 'RustConfig'
  asbuilt_rust.discover -[constructs]-> asbuilt_rust.error 'RustFrontendError'
  asbuilt_rust.discover -[uses]-> cargo 'runs'
  asbuilt_rust.resolve -[names]-> asbuilt_rust.visit 'Anchor, RawPath'
  asbuilt_rust.resolve -[names]-> asbuilt_rust.walk 'ModulePath'
  asbuilt_rust.tests -[calls]-> asbuilt_core.config 'Config'
  asbuilt_rust.tests -[calls]-> asbuilt_core.emit 'emit'
  asbuilt_rust.tests -[calls]-> asbuilt_core.frontend 'survey'
  asbuilt_rust.tests -[names]-> asbuilt_core.model 'Element, ElementKind, Model, Relation, RelationKind'
  asbuilt_rust.tests -[constructs]-> asbuilt_rust.config 'RustConfig'
  asbuilt_rust.tests -[calls]-> asbuilt_rust.discover 'TECHNOLOGY_BINARY, TECHNOLOGY_EXAMPLES, TECHNOLOGY_LIBRARY, TECHNOLOGY_LIBRARY_AND_BINARY, TECHNOLOGY_PROC_MACRO, TECHNOLOGY_PROC_MACRO_AND_BINARY, TECHNOLOGY_TESTS, TargetKind, discover'
  asbuilt_rust.tests -[names]-> asbuilt_rust.error 'RustFrontendError'
  asbuilt_rust.visit -[names]-> asbuilt_core.model 'RelationKind'
