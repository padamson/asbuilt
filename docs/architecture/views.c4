// Hand-written views over the generated model in model.c4. They name
// generated ids, so `asbuilt validate` (likec4 validate) is the gate: a
// module that is renamed or removed makes a view here fail to resolve.

views {
  view context {
    title 'asbuilt: the three crates and what they run'
    include asbuilt, asbuilt_core, asbuilt_rust, asbuilt_site, cargo, likec4, graphviz
    autoLayout LeftRight
  }

  view survey of asbuilt_rust {
    title 'asbuilt-rust: from cargo metadata to a model'
    include *, asbuilt_core.model, asbuilt_core.frontend, cargo
    autoLayout LeftRight
  }

  view core of asbuilt_core {
    title 'asbuilt-core: model, config, emitter, check'
    include *, asbuilt.commands
    autoLayout TopBottom
  }
}
