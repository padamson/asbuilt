  tag tests
  relationship implements
  relationship constructs
  relationship calls
  relationship names
  relationship uses
}

model {
  app = container 'app' {
    description 'The app.'
    technology 'library crate'
    metadata {
      path 'app'
    }
    link ../../app
    client = component 'client' {
      metadata {
        path 'app/src/client.rs'
      }
      link ../../app/src/client.rs
    }
    server = component 'server' {
      description 'Talks to the driver.'
      metadata {
        path 'app/src/server.rs'
      }
      link ../../app/src/server.rs
    }
  }
  e2e = container 'e2e' {
    technology 'test crate'
    metadata {
      path 'e2e'
    }
    link ../../e2e
    tests = tests 'tests' {
      #tests
      metadata {
        path 'e2e/tests'
      }
      link ../../e2e/tests
    }
  }
  node_driver = process 'Driver process' {
    #external
    description 'The driver the server spawns.'
    technology 'Node.js'
  }

  app.client -[calls]-> app.server 'Driver, spawn'
  app.server -[uses]-> node_driver 'spawns' {
    technology 'stdio'
  }
  e2e.tests -[calls]-> app.client 'client, connect'
}

views {
  view index {
    title 'Overview'
    include app, e2e, node_driver
    autoLayout LeftRight
  }

  view view_app of app {
    title 'app'
    include *
    autoLayout TopBottom
  }

  view view_e2e of e2e {
    title 'e2e'
    include *
    autoLayout TopBottom
  }
