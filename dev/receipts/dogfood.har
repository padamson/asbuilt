=\"315\" y=\"-1334\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">The library half of the `asbuilt` binary.</text>\n</g>\n<!-- asbuilt_rust -->\n<g id=\"node2\" class=\"node\">\n<title>asbuilt_rust</title>\n<polygon fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"0\" points=\"1136.5,-1050 816.5,-1050 816.5,-870 1136.5,-870 1136.5,-1050\"/>\n<text text-anchor=\"start\" x=\"928\" y=\"-974\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#eff6ff\">asbuilt&#45;rust</text>\n<text text-anchor=\"start\" x=\"941.5\" y=\"-953.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#bfdbfe\">library crate</text>\n<text text-anchor=\"start\" x=\"891.5\" y=\"-934\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">Rust front&#45;end for asbuilt.</text>\n</g>\n<!-- likec4 -->\n<g id=\"node3\" class=\"node\">\n<title>likec4</title>\n<polygon fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"0\" points=\"599,-470 279,-470 279,-290 599,-290 599,-470\"/>\n<text text-anchor=\"start\" x=\"389.5\" y=\"-411\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#eff6ff\">LikeC4 CLI</text>\n<text text-anchor=\"start\" x=\"345\" y=\"-390.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#bfdbfe\">Node.js via npx, pinned version</text>\n<text text-anchor=\"start\" x=\"299\" y=\"-371\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">Validates, exports and lays out the model.</text>\n<text text-anchor=\"start\" x=\"300\" y=\"-354\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">Only `validate`, `export json` and `render`</text>\n<text text-anchor=\"start\" x=\"411.5\" y=\"-337\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">reach it.</text>\n</g>\n<!-- graphviz -->\n<g id=\"node4\" class=\"node\">\n<title>graphviz</title>\n<polygon fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"0\" points=\"608.5,-760 269.5,-760 269.5,-580 608.5,-580 608.5,-760\"/>\n<text text-anchor=\"start\" x=\"382.5\" y=\"-693\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#eff6ff\">Graphviz dot</text>\n<text text-anchor=\"start\" x=\"393.5\" y=\"-672.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#bfdbfe\">dot subprocess</text>\n<text text-anchor=\"start\" x=\"290\" y=\"-653\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">Renders the Graphviz files LikeC4 generates</text>\n<text text-anchor=\"start\" x=\"412.5\" y=\"-636\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">to SVG.</text>\n</g>\n<!-- asbuilt_core -->\n<g id=\"node5\" class=\"node\">\n<title>asbuilt_core</title>\n<polygon fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"0\" points=\"599,-1050 279,-1050 279,-870 599,-870 599,-1050\"/>\n<text text-anchor=\"start\" x=\"387.5\" y=\"-974\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#eff6ff\">asbuilt&#45;core</text>\n<text text-anchor=\"start\" x=\"404\" y=\"-953.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#bfdbfe\">library crate</text>\n<text text-anchor=\"start\" x=\"312\" y=\"-934\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">The language&#45;agnostic core of asbuilt.</text>\n</g>\n<!-- asbuilt_site -->\n<g id=\"node6\" class=\"node\">\n<title>asbuilt_site</title>\n<polygon fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"0\" points=\"599,-1740 279,-1740 279,-1560 599,-1560 599,-1740\"/>\n<text text-anchor=\"start\" x=\"391\" y=\"-1654\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#eff6ff\">asbuilt&#45;site</text>\n<text text-anchor=\"start\" x=\"420.5\" y=\"-1633.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#bfdbfe\">binary</text>\n</g>\n<!-- asbuilt_site_e2e -->\n<g id=\"node7\" class=\"node\">\n<title>asbuilt_site_e2e</title>\n<polygon fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"0\" points=\"599,-2430 279,-2430 279,-2250 599,-2250 599,-2430\"/>\n<text text-anchor=\"start\" x=\"371\" y=\"-2344\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#eff6ff\">asbuilt&#45;site&#45;e2e</text>\n<text text-anchor=\"start\" x=\"411\" y=\"-2323.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#bfdbfe\">test crate</text>\n</g>\n<!-- chromium -->\n<g id=\"node8\" class=\"node\">\n<title>chromium</title>\n<polygon fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"0\" points=\"608,-2030 270,-2030 270,-1850 608,-1850 608,-2030\"/>\n<text text-anchor=\"start\" x=\"392.5\" y=\"-1963\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#eff6ff\">Chromium</text>\n<text text-anchor=\"start\" x=\"336.5\" y=\"-1942.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#bfdbfe\">Playwright driver, via playwright&#45;rs</text>\n<text text-anchor=\"start\" x=\"290\" y=\"-1923\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">The browser the site&#39;s end&#45;to&#45;end tests drive</text>\n<text text-anchor=\"start\" x=\"339.5\" y=\"-1906\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">against the built landing page.</text>\n</g>\n<!-- cargo -->\n<g id=\"node9\" class=\"node\">\n<title>cargo</title>\n<polygon fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"0\" points=\"607,-180 271,-180 271,0 607,0 607,-180\"/>\n<text text-anchor=\"start\" x=\"369.5\" y=\"-121\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#eff6ff\">cargo metadata</text>\n<text text-anchor=\"start\" x=\"385.5\" y=\"-100.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#bfdbfe\">cargo subprocess</text>\n<text text-anchor=\"start\" x=\"291\" y=\"-81\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">Lists the workspace&#39;s packages and targets;</text>\n<text text-anchor=\"start\" x=\"319\" y=\"-64\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">`&#45;&#45;no&#45;deps &#45;&#45;offline`, so no lockfile is</text>\n<text text-anchor=\"start\" x=\"410\" y=\"-47\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#bfdbfe\">touched.</text>\n</g>\n<!-- asbuilt&#45;&gt;asbuilt_rust -->\n<g id=\"edge1\" class=\"edge\">\n<title>asbuilt&#45;&gt;asbuilt_rust</title>\n<path fill=\"none\" stroke=\"#8d8d8d\" stroke-width=\"2\" stroke-dasharray=\"5,2\" d=\"M560.51,-1269.98C646.35,-1205.86 761.49,-1119.86 848.72,-1054.7\"/>\n<polygon fill=\"#8d8d8d\" stroke=\"#8d8d8d\" stroke-width=\"2\" points=\"850.51,-1056.64 854.95,-1050.05 847.37,-1052.43 850.51,-1056.64\"/>\n<polygon fill=\"#18191b\" fill-opacity=\"0.627451\" stroke=\"transparent\" points=\"668.5,-1183 668.5,-1204 756.5,-1204 756.5,-1183 668.5,-1183\"/>\n<text text-anchor=\"start\" x=\"671.5\" y=\"-1189.3\" font-family=\"Arial\" font-size=\"14.00\" fill=\"#c9c9c9\">RustFrontend</text>\n</g>\n<!-- asbuilt&#45;&gt;likec4 -->\n<g id=\"edge2\" class=\"edge\">\n<title>asbuilt&#45;&gt;likec4</title>\n<path fill=\"none\" stroke=\"#8d8d8d\" stroke-width=\"2\" stroke-dasharray=\"5,2\" d=\"M322.93,-1269.81C274.2,-1224.6 222.9,-1165.43 197,-1099.5 149.95,-979.73 208.18,-638.13 269.5,-525 279.11,-507.26 291.84,-490.74 306,-475.67\"/>\n<polygon fill=\"#8d8d8d\" stroke=\"#8d8d8d\" stroke-width=\"2\" points=\"307.97,-477.41 311.28,-470.18 304.19,-473.76 307.97,-477.41\"/>\n<polygon fill=\"#18191b\" fill-opacity=\"0.627451\" stroke=\"transparent\" points=\"153,-1078.5 153,-1099.5 186,-1099.5 186,-1078.5 153,-1078.5\"/>\n<text text-anchor=\"start\" x=\"156.5\" y=\"-1084.8\" font-family=\"Arial\" font-size=\"14.00\" fill=\"#c9c9c9\">runs</text>\n</g>\n<!-- asbuilt&#45;&gt;graphviz -->\n<g id=\"edge3\" class=\"edge\">\n<title>asbuilt&#45;&gt;graphviz</title>\n<path fill=\"none\" stroke=\"#8d8d8d\" stroke-width=\"2\" stroke-dasharray=\"5,2\" d=\"M343.18,-1269.83C281.6,-1204.97 207.08,-1111.75 173.5,-1012.5 141.37,-917.52 214.65,-828.6 292.3,-765.18\"/>\n<polygon fill=\"#8d8d8d\" stroke=\"#8d8d8d\" stroke-width=\"2\" points=\"294.19,-767.03 298.38,-760.28 290.89,-762.94 294.19,-767.03\"/>\n<polygon fill=\"#18191b\" fill-opacity=\"0.627451\" stroke=\"transparent\" points=\"129.5,-991.5 129.5,-1012.5 209.5,-1012.5 209.5,-991.5 129.5,-991.5\"/>\n<text text-anchor=\"start\" x=\"132.5\" y=\"-997.8\" font-family=\"Arial\" font-siz