ly=\"Arial\" font-size=\"15.00\" fill=\"#ffffe5\">arguments, and this</text>\n<text text-anchor=\"start\" x=\"306\" y=\"-1334\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#ffffe5\">library runs the subcommands (`commands`) and</text>\n<text text-anchor=\"start\" x=\"418.5\" y=\"-1317\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#ffffe5\">every call to the</text>\n<text text-anchor=\"start\" x=\"390\" y=\"-1300\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#ffffe5\">pinned LikeC4 (`likec4`).</text>\n</g>\n<!-- asbuilt_rust -->\n<g id=\"node2\" class=\"node\">\n<title>asbuilt_rust</title>\n<polygon fill=\"#ce422b\" stroke=\"#a11309\" stroke-width=\"0\" points=\"1184.5,-1050 864.5,-1050 864.5,-870 1184.5,-870 1184.5,-1050\"/>\n<text text-anchor=\"start\" x=\"976\" y=\"-974\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#fffffa\">asbuilt&#45;rust</text>\n<text text-anchor=\"start\" x=\"989.5\" y=\"-953.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#ffffe5\">library crate</text>\n<text text-anchor=\"start\" x=\"939.5\" y=\"-934\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#ffffe5\">Rust front&#45;end for asbuilt.</text>\n</g>\n<!-- likec4 -->\n<g id=\"node3\" class=\"node\">\n<title>likec4</title>\n<polygon fill=\"#e9d4c8\" stroke=\"#c0aca1\" stroke-width=\"0\" points=\"631,-470 311,-470 311,-290 631,-290 631,-470\"/>\n<text text-anchor=\"start\" x=\"421.5\" y=\"-411\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#48382f\">LikeC4 CLI</text>\n<text text-anchor=\"start\" x=\"377\" y=\"-390.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#59493f\">Node.js via npx, pinned version</text>\n<text text-anchor=\"start\" x=\"331\" y=\"-371\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">Validates, exports and lays out the model.</text>\n<text text-anchor=\"start\" x=\"332\" y=\"-354\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">Only `validate`, `export json` and `render`</text>\n<text text-anchor=\"start\" x=\"443.5\" y=\"-337\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">reach it.</text>\n</g>\n<!-- graphviz -->\n<g id=\"node4\" class=\"node\">\n<title>graphviz</title>\n<polygon fill=\"#e9d4c8\" stroke=\"#c0aca1\" stroke-width=\"0\" points=\"640.5,-760 301.5,-760 301.5,-580 640.5,-580 640.5,-760\"/>\n<text text-anchor=\"start\" x=\"414.5\" y=\"-693\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#48382f\">Graphviz dot</text>\n<text text-anchor=\"start\" x=\"425.5\" y=\"-672.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#59493f\">dot subprocess</text>\n<text text-anchor=\"start\" x=\"322\" y=\"-653\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">Renders the Graphviz files LikeC4 generates</text>\n<text text-anchor=\"start\" x=\"444.5\" y=\"-636\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">to SVG.</text>\n</g>\n<!-- asbuilt_core -->\n<g id=\"node5\" class=\"node\">\n<title>asbuilt_core</title>\n<polygon fill=\"#ce422b\" stroke=\"#a11309\" stroke-width=\"0\" points=\"631,-1050 311,-1050 311,-870 631,-870 631,-1050\"/>\n<text text-anchor=\"start\" x=\"419.5\" y=\"-974\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#fffffa\">asbuilt&#45;core</text>\n<text text-anchor=\"start\" x=\"436\" y=\"-953.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#ffffe5\">library crate</text>\n<text text-anchor=\"start\" x=\"344\" y=\"-934\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#ffffe5\">The language&#45;agnostic core of asbuilt.</text>\n</g>\n<!-- asbuilt_site -->\n<g id=\"node6\" class=\"node\">\n<title>asbuilt_site</title>\n<polygon fill=\"#ce422b\" stroke=\"#a11309\" stroke-width=\"0\" points=\"631,-1740 311,-1740 311,-1560 631,-1560 631,-1740\"/>\n<text text-anchor=\"start\" x=\"423\" y=\"-1654\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#fffffa\">asbuilt&#45;site</text>\n<text text-anchor=\"start\" x=\"435.5\" y=\"-1633.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#ffffe5\">binary crate</text>\n</g>\n<!-- asbuilt_site_e2e -->\n<g id=\"node7\" class=\"node\">\n<title>asbuilt_site_e2e</title>\n<polygon fill=\"#ce422b\" stroke=\"#a11309\" stroke-width=\"0\" points=\"631,-2430 311,-2430 311,-2250 631,-2250 631,-2430\"/>\n<text text-anchor=\"start\" x=\"403\" y=\"-2344\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#fffffa\">asbuilt&#45;site&#45;e2e</text>\n<text text-anchor=\"start\" x=\"443\" y=\"-2323.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#ffffe5\">test crate</text>\n</g>\n<!-- chromium -->\n<g id=\"node8\" class=\"node\">\n<title>chromium</title>\n<polygon fill=\"#e9d4c8\" stroke=\"#c0aca1\" stroke-width=\"0\" points=\"640,-2030 302,-2030 302,-1850 640,-1850 640,-2030\"/>\n<text text-anchor=\"start\" x=\"424.5\" y=\"-1963\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#48382f\">Chromium</text>\n<text text-anchor=\"start\" x=\"368.5\" y=\"-1942.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#59493f\">Playwright driver, via playwright&#45;rs</text>\n<text text-anchor=\"start\" x=\"322\" y=\"-1923\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">The browser the site&#39;s end&#45;to&#45;end tests drive</text>\n<text text-anchor=\"start\" x=\"371.5\" y=\"-1906\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">against the built landing page.</text>\n</g>\n<!-- cargo -->\n<g id=\"node9\" class=\"node\">\n<title>cargo</title>\n<polygon fill=\"#e9d4c8\" stroke=\"#c0aca1\" stroke-width=\"0\" points=\"639,-180 303,-180 303,0 639,0 639,-180\"/>\n<text text-anchor=\"start\" x=\"401.5\" y=\"-121\" font-family=\"Arial\" font-size=\"20.00\" fill=\"#48382f\">cargo metadata</text>\n<text text-anchor=\"start\" x=\"417.5\" y=\"-100.6\" font-family=\"Arial\" font-size=\"13.00\" fill=\"#59493f\">cargo subprocess</text>\n<text text-anchor=\"start\" x=\"323\" y=\"-81\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">Lists the workspace&#39;s packages and targets;</text>\n<text text-anchor=\"start\" x=\"351\" y=\"-64\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">`&#45;&#45;no&#45;deps &#45;&#45;offline`, so no lockfile is</text>\n<text text-anchor=\"start\" x=\"442\" y=\"-47\" font-family=\"Arial\" font-size=\"15.00\" fill=\"#59493f\">touched.</text>\n</g>\n<!-- asbuilt&#45;&gt;asbuilt_rust -->\n<g id=\"edge1\" class=\"edge\">\n<title>asbuilt&#45;&gt;asbuilt_rust</title>\n<path fill=\"none\" stroke=\"#8d8d8d\" stroke-width=\"2\" stroke-dasharray=\"5,2\" d=\"M596.11,-1269.98C684.6,-1205.8 803.34,-1119.68 893.2,-1054.51\"/>\n<polygon fill=\"#8d8d8d\" stroke=\"#8d8d8d\" stroke-width=\"2\" points=\"894.82,-1056.58 899.35,-1050.05 891.73,-1052.33 894.82,-1056.58\"/>\n<polygon fill=\"#18191b\" fill-opacity=\"0.627451\" stroke=\"transparent\" points=\"716.5,-1171 716.5,-1192 804.5,-1192 804.5,-1171 716.5,-1171\"/>\n<text text-anchor=\"start\" x=\"719.5\" y=\"-1177.3\" font-family=\"Arial\" font-size=\"14.00\" fill=\"#c9c9c9\">RustFrontend</text>\n</g>\n<!-- asbuilt&#45;&gt;likec4 -->\n<g id=\"edge2\" class=\"edge\">\n<title>asbuilt&#45;&gt;likec4</title>\n<path fill=\"none\" stroke=\"#8d8d8d\" stroke-width=\"2\" stroke-dasharray=\"5,2\" d=\"M347.49,-1269.83C296.57,-1225.01 243.19,-1166.16 216,-1099.5 167.42,-980.43 222.04,-636.85 285.5,-525 295.65,-507.11 308.98,-490.65 323.84,-475.75\"/>\n<polygon fill=\"#8d8d8d\" stroke=\"#8d8d8d\" stroke-width=\"2\" points=\"325.86,-477.45 329.38,-470.33 322.19,-473.7 325.86,-477.45\"/>\n<polygon fill=\"#18191b\" fill-opacity=\"0.627451\" stroke=\"transparent\" points=\"169,-1078.5 169,-1099.5 202,-1099.5 202,-1078.5 169,-1078.5\"/>\n<text text-anchor=\"start\" x=\"172.5\" y=\"-1084.8\" font-family=\"Arial\" font-size=\"14.00\" fill=\"#c9c9c9\">runs</text>\n</g>\n<!-- asbuilt&#45;&gt;graphviz -->\n<g id=\"edge3\" class=\"edge\">\n<title>asbuilt&#45;&gt;graphviz</title>\n<path fill=\"none\" stroke=\"#8d8d8d\" stroke-width=\"2\" stroke-dasharray=\"5,2\" d=\"M369.52,-1269.68C305.18,-1205.27 227.67,-1112.62 192.5,-1012.5 158.77,-916.48 234.97,-8